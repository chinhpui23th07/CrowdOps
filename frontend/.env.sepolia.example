# Cấu hình chạy web trên SEPOLIA (bản đã deploy, địa chỉ contract nằm sẵn trong src/contracts/addresses.json).
# Sao chép thành .env.local:   cp .env.sepolia.example .env.local
VITE_CHAIN_ID=11155111
# RPC công khai để ĐỌC dữ liệu khi chưa kết nối ví (không cần API key)
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Server upload IPFS + cấp khóa giải mã (chạy ở thư mục server)
VITE_SERVER_URL=http://localhost:4000
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
