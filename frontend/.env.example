# Sao chép thành .env.local
# 31337 = Hardhat local, 11155111 = Sepolia
VITE_CHAIN_ID=31337
# RPC dùng để ĐỌC dữ liệu khi người dùng chưa kết nối ví
VITE_RPC_URL=http://127.0.0.1:8545
# Server upload IPFS + cấp khóa giải mã
VITE_SERVER_URL=http://localhost:4000
# Gateway để xem file IPFS (nên dùng dedicated gateway của Pinata nếu có)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
