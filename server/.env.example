# Sao chép thành .env. KHÔNG commit file .env.
PORT=4000
# 31337 = Hardhat local, 11155111 = Sepolia
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# JWT tạo tại https://app.pinata.cloud/developers/api-keys (quyền pinFileToIPFS)
