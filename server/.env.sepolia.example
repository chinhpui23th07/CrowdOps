# Cấu hình server cho SEPOLIA. Sao chép thành .env:   cp .env.sepolia.example .env
# KHÔNG commit file .env.
PORT=4000
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# JWT Pinata: xin trưởng nhóm qua tin nhắn riêng, KHÔNG dán vào file nào được commit.
# Thiếu JWT thì web vẫn xem được dữ liệu, nhưng không upload file mới được.
PINATA_JWT=
CORS_ORIGIN=http://localhost:5173
