# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.
# RPC Sepolia (Alchemy / Infura / public RPC)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# PRIVATE KEY (64 ký tự hex, KHÔNG phải địa chỉ ví 0x...40 ký tự) của các ví THỬ NGHIỆM dành riêng cho đồ án
# MetaMask: menu ⋮ của tài khoản -> Account details -> Show private key
DEPLOYER_PRIVATE_KEY=
BACKER1_PRIVATE_KEY=
BACKER2_PRIVATE_KEY=
BACKER3_PRIVATE_KEY=
# Tùy chọn: để verify contract trên Etherscan
ETHERSCAN_API_KEY=
